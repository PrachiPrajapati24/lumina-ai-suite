PORT=5000
# MongoDB Atlas connection string template
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lumina-ai?retryWrites=true&w=majority
# Alternatively, for local MongoDB development, use:
# MONGO_URI=mongodb://127.0.0.1:27017/lumina-ai

JWT_SECRET=lumina_ai_secret_jwt_token_key_change_in_production
GEMINI_API_KEY=your_gemini_api_key_here
